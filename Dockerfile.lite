# Agent World Lite — single-container build
# The whole product: diagnosis API + optional static frontend.
# No ChromaDB, Redis, Ollama, SQLAlchemy, or enterprise stack.

FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements-lite.txt .
RUN pip install --no-cache-dir -r requirements-lite.txt

COPY backend/ ./backend/

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "backend"]
